{
  "name": "optcg-fr",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host",
    "lint": "oxlint",
    "test": "vitest run",
    "backup:server": "node --env-file=server/.env.local --import tsx server/index.ts",
    "backup:setup": "node server/setup-local.mjs",
    "backup:check": "tsc -p tsconfig.server.json",
    "backup:build": "node server/build-vercel.mjs",
    "data:cards": "node scripts/build-catalogue.mjs",
    "data:cards:force": "node scripts/build-catalogue.mjs --force",
    "data:prices": "node scripts/update-prices.mjs",
    "data:hashes": "node scripts/build-hashes.mjs",
    "data:sample-alpha": "node scripts/build-sample-alpha.mjs",
    "data:all": "npm run data:cards && npm run data:prices && npm run data:hashes && npm run data:images",
    "icons": "node scripts/make-icons.mjs",
    "data:images": "node scripts/build-images.mjs",
    "data:prices-fr": "node scripts/update-prices-fr.mjs"
  },
  "dependencies": {
    "@capacitor/cli": "^7.6.9",
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@libsql/client": "^0.18.0",
    "@tailwindcss/vite": "^4.3.3",
    "dexie": "^4.4.6",
    "dexie-react-hooks": "^4.4.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^7.18.4",
    "tailwindcss": "^4.3.3",
    "tesseract.js": "^7.0.0",
    "tsx": "^4.23.15",
    "vite-plugin-pwa": "^1.3.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "cheerio": "^1.2.0",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "oxlint": "^1.81.0",
    "sharp": "^0.35.4",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^4.1.11"
  }
}

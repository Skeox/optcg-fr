{
  "name": "optcg-fr",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host",
    "lint": "oxlint",
    "data:cards": "node scripts/build-catalogue.mjs",
    "data:cards:force": "node scripts/build-catalogue.mjs --force",
    "data:prices": "node scripts/update-prices.mjs",
    "data:hashes": "node scripts/build-hashes.mjs",
    "data:all": "npm run data:cards && npm run data:prices && npm run data:hashes",
    "icons": "node scripts/make-icons.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "dexie": "^4.4.6",
    "dexie-react-hooks": "^4.4.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^7.18.4",
    "tailwindcss": "^4.3.3",
    "tesseract.js": "^7.0.0",
    "vite-plugin-pwa": "^1.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "cheerio": "^1.2.0",
    "oxlint": "^1.81.0",
    "sharp": "^0.35.4",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
